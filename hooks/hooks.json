{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {"type": "command", "command": "/bin/sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; exec python3 \"$0\"' \"${CLAUDE_PLUGIN_ROOT}\"/hooks/lead_context.py", "timeout": 5}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "/bin/sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; exec python3 \"$0\"' \"${CLAUDE_PLUGIN_ROOT}\"/hooks/lead_context.py", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "/bin/sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; exec python3 \"$0\"' \"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop_guard.py", "timeout": 5}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/subagent_start.py", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre_tool_use.py", "timeout": 5}
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre_tool_use.py", "timeout": 5}
        ]
      },
      {
        "matcher": "mcp__plugin_agent-runtime_agent-runtime__.*",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre_tool_use.py", "timeout": 5}
        ]
      }
    ]
  }
}
